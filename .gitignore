*.db
__pycache__/
*.pyc
.env

# Backup files
*.bak

# iOS build artifacts (matches whatcolor convention)
ios/build/
xcuserdata/

# macOS
.DS_Store

# fastlane staging (generated by the upload_listing lane)
ios/fastlane/screenshots/
ios/fastlane/report.xml
ios/fastlane/README.md
Gemfile.lock

# Android TWA build (bubblewrap). The generated Android project is
# rebuilt from android-build/twa-manifest.json via `bubblewrap build`,
# so only the manifest is tracked. The signing keystore is a secret and
# this repo is public: it stays out of git and is backed up to
# ~/documentation/keystores/ instead.
android-build/*
!android-build/twa-manifest.json
!android-build/package.json
!android-build/package-lock.json
!android-build/README.md
!android-build/verify-release.mjs
!android-build/stage-release.mjs

# Local development environments
.venv/

# Private review contact and machine-specific permissions
ios/fastlane/metadata/review_information/phone_number.txt
.claude/settings.local.json
.claude/settings.json
